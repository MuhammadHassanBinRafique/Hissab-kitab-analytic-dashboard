# Supabase project (same one the Hisab-Kitab portal uses). Only the PUBLIC anon key; never service_role.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[ANON_KEY]
# Connection string for the READ-ONLY role created by db/analytics_ro.sql (NOT the portal's DATABASE_URL).
ANALYTICS_DATABASE_URL=postgresql://analytics_ro.[PROJECT-REF]:[PASSWORD]@[HOST]:6543/postgres
# Any long random string (32+ chars). Signs the dashboard session cookie.
SESSION_SECRET=
# Where the dashboard web app is served from (used for the CSRF origin check).
ALLOWED_ORIGIN=http://localhost:3000
PORT=8787
